# Plantilla de variables de entorno.
# Copia este archivo como .env y rellena los valores. NO subas el .env al repositorio.

# URL de la base de datos en Turso (la entrega "turso db show <db>").
TURSO_DATABASE_URL=libsql://<tu-base>.turso.io

# Token de acceso a la base (se genera con "turso db tokens create <db>").
# Es una credencial: nunca lo compartas ni lo subas a git.
TURSO_AUTH_TOKEN=

# Ruta del archivo SQLite local. Con Turso activo esto es solo la replica
# (cache); los datos reales viven en la nube.
DB_PATH=./server/data/medcontrol.db

# Orígenes permitidos por CORS, separados por coma. Usa * para permitir todos.
ALLOWED_ORIGINS=*

# Secreto para firmar los JWT de sesion.
JWT_SECRET=
